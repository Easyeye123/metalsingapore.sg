# Portfolio admin — defence-in-depth
# Apache configuration for /portfolio-admin/

# Deny direct execution of helpers in lib/ (we still require_once them from PHP).
<FilesMatch "^(auth|config|projects|totp|view|security_headers)\.php$">
    Require all denied
</FilesMatch>

# Block directory listing.
Options -Indexes

# Block common backup / hidden file fetches.
<FilesMatch "(\.bak|\.swp|\.orig|~)$">
    Require all denied
</FilesMatch>

# Stronger headers from Apache layer (PHP also sends them).
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
    Header always unset Server
    Header always unset X-Powered-By
</IfModule>
